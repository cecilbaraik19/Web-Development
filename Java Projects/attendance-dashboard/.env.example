# Copy this file to .env and change every value marked CHANGE_ME.
# .env is in .gitignore - never commit real passwords.

# --- database ---
DB_USERNAME=attendance
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# --- security ---
# 32+ random characters. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=CHANGE_ME_use_a_long_random_string_of_at_least_32_characters
# Password for the first 'admin' login (leave empty to get a random one printed in the backend log)
ADMIN_PASSWORD=CHANGE_ME_Admin1

# true = add the 24 demo employees + demo accounts (good for showing the project)
SEED_DEMO_DATA=true

# --- web ---
HTTP_PORT=80
PUBLIC_URL=http://localhost

# --- email (optional; without it alerts are only logged) ---
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=AttendTrack <no-reply@attendtrack.local>
ADMIN_EMAIL=
